# Copy to .env and fill in. .env is gitignored — never commit real values.
#
# Values are filled in as you go: the RPC endpoints and keys first, then each
# address as the script that deploys it prints it. Every script tells you
# which variable to set next.

# ─── Ethereum Sepolia ────────────────────────────────────────────────────────

# Sepolia RPC endpoint (Alchemy, Infura, or a public one).
SEPOLIA_RPC_URL=

# Testnet-only EOA private key for the NameGate issuer account. This account
# needs Sepolia ETH for gas. It is the account that holds ROLE_REGISTRAR on
# the UserRegistry and controls the compliance resolver.
# TESTNET KEY ONLY. Never put a real/mainnet key in this file.
ISSUER_PRIVATE_KEY=

# The 2LD you registered on ENSv2 Sepolia yourself, before running anything
# here. Scripts derive the labelhash themselves; this is for sanity checks.
NAMEGATE_LABEL=namegate

# Printed by `npm run ens:setup`. The resolver every investor subname points
# at, and the registry those subnames live in.
ISSUER_RESOLVER_ADDRESS=
ISSUER_USER_REGISTRY_ADDRESS=

# Printed by `npm run hedera:deploy-mirror`. The beacon's receiver — it must
# exist BEFORE the beacon is deployed, since the beacon's receiver address is
# immutable.
MIRROR_ADDRESS=

# k-of-n EIP-712 attestation fallback — the path used during live Q&A while
# a CCIP message for a demo beat is still in flight. Generate real testnet
# keys, e.g.:
#   node --import tsx -e 'import("viem/accounts").then(({generatePrivateKey,privateKeyToAccount})=>{const k=generatePrivateKey();console.log(k,privateKeyToAccount(k).address)})'
# NEVER use these keys for anything beyond a testnet demo.
ATTESTATION_SIGNER_1_KEY=
ATTESTATION_SIGNER_2_KEY=
ATTESTATION_SIGNER_3_KEY=
ATTESTATION_SIGNERS=
ATTESTATION_THRESHOLD=2
ATTESTATION_VALIDITY_WINDOW_SECONDS=600

# Printed by `npm run ens:deploy-beacon`. Reads compliance records on-chain
# and forwards them to Hedera over CCIP. Requires MIRROR_ADDRESS above.
BEACON_ADDRESS=

# Gas allowance for the CCIP callback on Hedera. Optional — defaults to
# 400000, which is deliberately generous because the receiver decodes a
# payload containing four dynamic strings and Hedera's gas accounting is not
# Ethereum's. Lower it once measured against the real receiver.
DESTINATION_GAS_LIMIT=

# An investor address used as a demo holder. Subnames are registered to it.
INVESTOR_A_ADDRESS=

# ─── Hedera testnet (chain ID 296) ───────────────────────────────────────────

# All Hedera scripts go through Hashio's EVM JSON-RPC relay via viem, so only
# the ECDSA hex private key is needed — not the native 0.0.x operator ID
# (Hedera's own SDK format), which nothing in this repo uses.
# Must be ECDSA hex (0x...), not Hedera Portal's DER-encoded default export.
HEDERA_OPERATOR_KEY=
HEDERA_RPC_URL=https://testnet.hashio.io/api

# Printed by `npm run hedera:deploy-control-list` and
# `npm run hedera:deploy-bond`.
ENS_CONTROL_LIST_ADDRESS=
BOND_ADDRESS=

# Printed by `npm run hedera:deploy-mirror` (the CCIP receiver) and
# `npm run hedera:deploy-distributor` (the coupon payout contract).
MIRROR_ADDRESS=
COUPON_DISTRIBUTOR_ADDRESS=

# Printed by `npm run hedera:deploy-pause-switch` and
# `npm run hedera:deploy-price-reader`.
PAUSE_SWITCH_ADDRESS=
PRICE_READER_ADDRESS=

# Printed by `npm run hedera:set-coupon`.
COUPON_ID=

# Tinybar (NOT wei — 1 HBAR = 10^8 tinybar) paid per whole unit of the
# bond's declared currency. Optional — defaults to 1_000_000 (0.01 HBAR).
# See CouponDistributor.sol's header for why this is tinybar and not wei.
PAYOUT_SCALE_TINYBAR=

# ─── Contract verification ───────────────────────────────────────────────────

# Only needed to publish the Sepolia beacon's source with `hardhat verify`.
# Hedera contracts verify through Sourcify, which needs no key.
ETHERSCAN_API_KEY=

# ─── Privy ────────────────────────────────────────────────────────────────────

# From dashboard.privy.io. The app id is also needed (VITE_-prefixed) in
# frontend/.env.local — the secret must NEVER go there or anywhere else with
# a VITE_ prefix, since those ship straight into the browser bundle. It is
# only ever read by privy/scripts/01-create-org-wallet.ts, run locally.
PRIVY_APP_ID=
PRIVY_APP_SECRET=

# Printed by `npm run privy:create-org-wallet`. A server-controlled wallet
# whose attached policy restricts it to sending transactions ONLY to
# BEACON_ADDRESS and COUPON_DISTRIBUTOR_ADDRESS above.
PRIVY_ORG_WALLET_ID=
PRIVY_ORG_WALLET_ADDRESS=
PRIVY_ORG_WALLET_POLICY_ID=
