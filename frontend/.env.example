# Copy to .env.local and fill in. Vite only exposes vars prefixed VITE_ to
# the browser bundle — never put a private key or API secret in here, since
# anything with that prefix ships in the compiled JS anyone can read.

# RPC endpoints the dashboard reads from directly (read-only calls; writes
# go through the connected wallet, never through a key held by this app).
VITE_SEPOLIA_RPC_URL=https://ethereum-sepolia-rpc.publicnode.com
VITE_HEDERA_RPC_URL=https://testnet.hashio.io/api

# Same contracts the backend scripts deployed — see the root .env.example.
VITE_BEACON_ADDRESS=
VITE_MIRROR_ADDRESS=
VITE_BOND_ADDRESS=
VITE_COUPON_DISTRIBUTOR_ADDRESS=
VITE_PAUSE_SWITCH_ADDRESS=
VITE_PRICE_READER_ADDRESS=
VITE_COUPON_ID=1

# Same resolver/registry the root .env's ISSUER_RESOLVER_ADDRESS /
# ISSUER_USER_REGISTRY_ADDRESS point at — needed for the onboarding flow
# (register + set compliance). Onboarding write calls only succeed if the
# connected wallet actually holds the issuer's roles on these contracts;
# anyone else gets a real, honest revert.
VITE_ISSUER_RESOLVER_ADDRESS=
VITE_ISSUER_USER_REGISTRY_ADDRESS=

# The two demo investors: ENS label (under namegate.eth) plus the address
# that label is registered to, so the dashboard can look each one up by
# name (beacon.readCompliance) and by address (mirror.isAuthorized,
# distributor.previewAmount) without guessing the pairing.
VITE_INVESTOR_A_LABEL=investora
VITE_INVESTOR_A_ADDRESS=
VITE_INVESTOR_B_LABEL=investorb
VITE_INVESTOR_B_ADDRESS=

# From the Privy dashboard (dashboard.privy.io) — an App ID is public and
# safe to ship in the bundle. Wallet connect and the org-wallet policy
# control do nothing without a real one; this project cannot create a
# Privy account on your behalf, so this has to come from you.
VITE_PRIVY_APP_ID=
